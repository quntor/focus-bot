# Значения не хранятся в репозитории. Здесь только имена переменных.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Случайная строка из A-Z, a-z, 0-9, _ и -, 32–256 символов. Telegram присылает её
# в заголовке X-Telegram-Bot-Api-Secret-Token, запросы без неё не принимаются.
TELEGRAM_WEBHOOK_SECRET=
# Другая случайная строка того же вида — сегмент пути вебхука /tg/<путь>.
# Не совпадает с секретом: путь оседает в логах прокси.
TELEGRAM_WEBHOOK_PATH=

DATABASE_URL=postgresql://focus:focus@localhost:5432/focus
# База для тестов. Тесты стирают таблицы — никогда не указывать здесь рабочую.
TEST_DATABASE_URL=

# Провайдер модели. Ключ и адрес задаются снаружи, код о конкретном провайдере не знает.
LLM_API_KEY=
LLM_BASE_URL=

PORT=3000

# Ссылка на политику обработки персональных данных (152-ФЗ), показывается при согласии.
PRIVACY_POLICY_URL=
