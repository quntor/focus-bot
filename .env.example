# Значения не хранятся в репозитории. Здесь только имена переменных.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Произвольная строка. Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token,
# запросы без неё на вебхук не принимаются.
TELEGRAM_WEBHOOK_SECRET=

DATABASE_URL=postgresql://focus:focus@localhost:5432/focus

# Провайдер модели. Ключ и адрес задаются снаружи, код о конкретном провайдере не знает.
LLM_API_KEY=
LLM_BASE_URL=

PORT=3000
